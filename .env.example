# Meeting -> Execution runs on a deterministic mock extractor and mock integration providers by
# default, so no API keys are needed to develop, test, build, or run the demo.

# Which extractor to use: "mock" (default, deterministic) or a real provider you wire in.
MEETING_EXTRACTOR=mock

# Only needed if you wire real integrations (GitHub/Slack/etc.) behind the Provider interface.
# Never commit real tokens.
# GITHUB_TOKEN=...
# SLACK_TOKEN=...
